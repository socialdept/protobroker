{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "protobroker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    // Hosts the broker will redirect callbacks to. Exact hosts or "*.suffix".
    "ALLOWED_CALLBACK_HOSTS": "localhost,127.0.0.1,[::1],*.test,*.localhost,*.local",
    // Origin client ids are minted under. Empty means the request origin.
    "PUBLIC_URL": ""
  },
  "env": {
    // The public instance at proto.broker, deployed by Workers Builds with
    // `npx wrangler deploy --env production`. Self-hosters use the default
    // config above and never touch this block.
    "production": {
      "name": "protobroker",
      "routes": [{ "pattern": "proto.broker", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "ALLOWED_CALLBACK_HOSTS": "localhost,127.0.0.1,[::1],*.test,*.localhost,*.local",
        "PUBLIC_URL": "https://proto.broker"
      }
    }
  }
}
